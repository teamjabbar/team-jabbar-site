---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { liveProjects } from '../../projects';
import { asset } from '../../assets';
import { site } from '../../site';

export async function getStaticPaths() {
  const projects = await liveProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const where = d.area ? `${d.area}, ${d.city}` : d.city;
const mono = d.name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const others = (await liveProjects()).filter((p) => p.id !== project.id).slice(0, 3);
const updated = d.updated.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const hero = asset(d.image);
const photos = d.photos.map((p) => asset(p)!);
const sitePlan = asset(d.sitePlan);
const kinds = [...new Set(d.models.map((m) => m.kind))];
const hasPlans = d.models.some((m) => m.plans.length > 0);
---
<Base title={`${d.name} by ${d.builder}, ${d.city}`} description={d.summary}>
  <section class="page-head pattern" style="padding-block:2rem 2.25rem">
    <div class="wrap">
      <p class="meta"><a href="/pre-construction/">Pre-construction</a> / {d.city}</p>
      <h1 style="margin-top:0.3em;font-size:clamp(2rem,4.5vw,3.2rem)">{d.name}</h1>
      <p class="lede">{where} · by {d.builder} · {d.status}</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap article-grid">
      <div>
        <div class="project-pic project-hero">
          {hero ? <img src={hero.src} width={hero.w} height={hero.h} alt={`${d.name} by ${d.builder}`} /> : <span class="mono" aria-hidden="true">{mono}</span>}
        </div>
        {photos.length > 0 && (
          <div class="photo-strip">
            {photos.map((p) => <button type="button" class="zoom" data-zoom={JSON.stringify([p.src])} data-title={d.name}><img src={p.src} width={p.w} height={p.h} alt={`${d.name} photo`} loading="lazy" /></button>)}
          </div>
        )}
        {hero && <p class="fine">Images and renderings courtesy of {d.builder}. Renderings are artist's concepts.</p>}

        <p class="lede" style="color:var(--ink)">{d.summary}</p>

        <table class="fact-table"><tbody>
          <tr><th>Builder</th><td>{d.builder}</td></tr>
          <tr><th>Location</th><td>{where}</td></tr>
          <tr><th>Home types</th><td>{d.homeTypes.join(', ')}</td></tr>
          <tr><th>Status</th><td>{d.status}</td></tr>
          {d.priceFrom && <tr><th>Prices</th><td>From {d.priceFrom}</td></tr>}
          {d.occupancy && <tr><th>Occupancy</th><td>{d.occupancy}</td></tr>}
          {d.deposit && <tr><th>Deposit</th><td>{d.deposit}</td></tr>}
        </tbody></table>

        {d.highlights.length > 0 && (
          <div class="prose">
            <h2 style="margin-top:0">Highlights</h2>
            <ul>{d.highlights.map((h) => <li>{h}</li>)}</ul>
          </div>
        )}

        {d.models.length > 0 && (
          <div class="models" id="homes">
            <h2>{hasPlans ? 'Homes and floor plans' : 'Homes available'}</h2>
            {kinds.map((kind) => (
              <>
                {kinds.length > 1 && <h3 class="model-kind">{kind === 'Townhouse' ? 'Townhomes' : `${kind} homes`}</h3>}
                <ul class="model-grid">
                  {d.models.filter((m) => m.kind === kind).map((m) => {
                    const pic = asset(m.image);
                    const plans = m.plans.map((p) => asset(p)!.src);
                    return (
                      <li class="model">
                        {pic && <img src={pic.src} width={pic.w} height={pic.h} alt={`${m.name} exterior`} loading="lazy" />}
                        <div class="model-body">
                          <h4>{m.name}</h4>
                          <p class="model-facts">{[m.beds && `${m.beds} bed`, m.baths && `${m.baths} bath`, m.size].filter(Boolean).join(' · ')}</p>
                          {m.note && <p class="model-facts">{m.note}</p>}
                          {m.price && <p class="model-price">From {m.price}</p>}
                          <div class="model-actions">
                            {plans.length > 0 && <button type="button" class="zoom link" data-zoom={JSON.stringify(plans)} data-title={`${m.name} floor plan`}>View floor plan</button>}
                            <a href="#start" data-ask={m.name}>Ask about this home</a>
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </>
            ))}
          </div>
        )}

        {sitePlan && (
          <div class="models">
            <h2>Site plan</h2>
            <button type="button" class="zoom site-plan" data-zoom={JSON.stringify([sitePlan.src])} data-title={`${d.name} site plan`}><img src={sitePlan.src} width={sitePlan.w} height={sitePlan.h} alt={`${d.name} site plan`} loading="lazy" /></button>
          </div>
        )}

        <div class="prose"><Content /></div>

        <p class="fine" style="margin-top:2rem">
          Details last checked {updated}. Prices, plans, sizes, deposits and dates are set by the builder and can change
          without notice. E. &amp; O.E. {site.name}, {site.brokerage.name}, is not the builder of this project.
        </p>
      </div>

      <aside class="article-side" id="start">
        <LeadForm type="preconstruction" project={d.name} heading={`Get floor plans and prices for ${d.name}`} button="Send me the details" success="Request received. We'll get back to you with the details." />
        <p class="fine" style="margin-top:1rem;text-align:center">Or call or text <a href={site.phoneHref}>{site.phone}</a></p>
      </aside>
    </div>
  </section>

  {others.length > 0 && (
    <section class="band band-pale">
      <div class="wrap">
        <div class="section-head"><h2>More upcoming projects</h2><a class="btn btn-line" href="/pre-construction/">See all projects</a></div>
        <ul class="project-grid">{others.map((p) => <li><ProjectCard project={p} /></li>)}</ul>
      </div>
    </section>
  )}

  <dialog class="viewer" id="viewer" aria-labelledby="viewer-title">
    <div class="viewer-bar"><p id="viewer-title"></p><button type="button" id="viewer-close" class="btn btn-line">Close</button></div>
    <div class="viewer-body" id="viewer-body"></div>
  </dialog>

  <script is:inline>
    (() => {
      const viewer = document.getElementById('viewer');
      const body = document.getElementById('viewer-body');
      document.querySelectorAll('.zoom').forEach((btn) => btn.addEventListener('click', () => {
        document.getElementById('viewer-title').textContent = btn.dataset.title;
        body.replaceChildren(...JSON.parse(btn.dataset.zoom).map((src) => Object.assign(new Image(), { src, alt: btn.dataset.title })));
        viewer.showModal();
      }));
      document.getElementById('viewer-close').addEventListener('click', () => viewer.close());
      viewer.addEventListener('click', (e) => { if (e.target === viewer) viewer.close(); });

      // "Ask about this home" carries the model name into the form
      const form = document.querySelector('#start form');
      const project = form.querySelector('input[name=project]');
      const base = project.value;
      const heading = form.querySelector('h3');
      const original = heading.textContent;
      document.querySelectorAll('[data-ask]').forEach((a) => a.addEventListener('click', () => {
        project.value = base + ' / ' + a.dataset.ask;
        heading.textContent = 'Ask about the ' + a.dataset.ask.replace(/^The /, '') + ' at ' + base;
        setTimeout(() => form.querySelector('input[name=name]').focus({ preventScroll: true }), 400);
      }));
      form.addEventListener('reset', () => { setTimeout(() => { project.value = base; heading.textContent = original; }); });
    })();
  </script>
</Base>
