---
import Base from '../layouts/Base.astro';
---
<Base title="Ontario land transfer tax calculator" description="Calculate Ontario land transfer tax and Toronto's municipal land transfer tax, including first-time home buyer rebates.">
  <section class="page-head">
    <div class="wrap">
      <h1>Land transfer tax calculator</h1>
      <p class="lede">Buyers in Ontario pay this tax on closing. Buyers in the City of Toronto pay a second, municipal one.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <form class="form" id="calc">
        <div class="field"><label for="l-price">Purchase price ($)</label><input id="l-price" type="number" min="0" step="1000" value="900000" inputmode="numeric" /></div>
        <label class="check"><input type="checkbox" id="l-toronto" /> The home is in the City of Toronto</label>
        <label class="check"><input type="checkbox" id="l-first" /> I am a first-time home buyer</label>
        <p class="fine">For a house or condo with one or two homes in it. Toronto means the city itself, not Mississauga, Brampton, Vaughan or the rest of the GTA.</p>
      </form>
      <div>
        <h2>Tax due on closing</h2>
        <p class="calc-out" id="l-out" aria-live="polite"></p>
        <table class="result-table">
          <tr><th>Ontario land transfer tax</th><td id="l-on"></td></tr>
          <tr id="l-tor-row"><th>Toronto land transfer tax</th><td id="l-tor"></td></tr>
          <tr id="l-reb-row"><th>First-time buyer rebates</th><td id="l-reb"></td></tr>
          <tr class="total"><th>Total</th><td id="l-total"></td></tr>
        </table>
        <p class="fine">An estimate using Ontario's rates and the City of Toronto rates in effect since April 1, 2026. First-time buyer rebates are up to $4,000 from Ontario and up to $4,475 from Toronto, and have eligibility rules. Toronto also charges a small administration fee. Your lawyer confirms the exact amount.</p>
        <div class="actions"><a class="btn" href="/buy/">Start my home search</a></div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const money = (n) => n.toLocaleString('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 });
      // [upper limit of bracket, rate]
      const ON = [[55000, 0.005], [250000, 0.01], [400000, 0.015], [2000000, 0.02], [Infinity, 0.025]];
      const TO = [[55000, 0.005], [250000, 0.01], [400000, 0.015], [2000000, 0.02], [3000000, 0.025],
        [4000000, 0.044], [5000000, 0.0545], [10000000, 0.065], [20000000, 0.0755], [Infinity, 0.086]];
      const tax = (price, table) => {
        let t = 0, lower = 0;
        for (const [upper, rate] of table) {
          if (price > lower) t += (Math.min(price, upper) - lower) * rate;
          lower = upper;
        }
        return t;
      };
      const run = () => {
        const price = +$('l-price').value || 0;
        const inTo = $('l-toronto').checked;
        const first = $('l-first').checked;
        const on = tax(price, ON);
        const tor = inTo ? tax(price, TO) : 0;
        const reb = first ? Math.min(on, 4000) + (inTo ? Math.min(tor, 4475) : 0) : 0;
        $('l-on').textContent = money(on);
        $('l-tor').textContent = money(tor);
        $('l-reb').textContent = '−' + money(reb);
        $('l-tor-row').hidden = !inTo;
        $('l-reb-row').hidden = !first;
        $('l-total').textContent = money(on + tor - reb);
        $('l-out').textContent = money(on + tor - reb);
      };
      $('calc').addEventListener('input', run);
      run();
    })();
  </script>
</Base>
