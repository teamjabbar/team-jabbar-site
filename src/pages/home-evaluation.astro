---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
import { site } from '../site';
import { sellSteps } from '../quizzes';
---
<Base title="Free home evaluation" description="Find out what your Ontario home is worth. Team Jabbar reviews recent sales near you and sends a written evaluation, free and with no obligation.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Get a free evaluation of your home</h1>
        <p class="lede">Tell us about your home. One of us reviews recent sales near you and sends back a written evaluation.</p>
        <ul class="ticks">
          <li>Prepared by a licensed agent on our team</li>
          <li>Anywhere in Ontario, from the GTA to Windsor, Ottawa and Sudbury</li>
          <li>Free, with no obligation to list with us</li>
        </ul>
        <div class="who"><p>Prefer to talk? Call or text <a href={site.phoneHref}>{site.phone}</a>.</p></div>
      </div>
      <div id="start">
        <Quiz id="q-eval" steps={sellSteps} fixedType="seller" heading="Free home evaluation" button="Send my evaluation" success="Request received. We'll send your evaluation shortly." />
      </div>
    </div>
  </section>
</Base>
