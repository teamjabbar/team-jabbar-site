---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
import LeadForm from '../components/LeadForm.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { liveProjects } from '../projects';
import { site, team, regions } from '../site';
import { asset } from '../assets';
import { homeSteps } from '../quizzes';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = await liveProjects();
const faces = [team[0].photo, team[1].photo, team[2].photo].filter(Boolean);
---
<Base title="Buy or sell a home in the GTA and Ontario" description="Tell Team Jabbar what you need in four quick questions. A licensed agent calls you with homes that fit, or a free evaluation of your home.">
  <section class="hero pattern">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Buying or selling a home in Ontario?</h1>
        <p class="lede">Answer four quick questions. A licensed agent from our family team gets back to you with a plan.</p>
        <ul class="ticks">
          <li>Selling: a free written evaluation of your home</li>
          <li>Buying: listings matched to your area and budget</li>
          <li>No cost and no obligation</li>
        </ul>
        <div class="who">
          <div class="faces">{faces.map((src) => <img src={asset(src)!.src} alt="" width="48" height="48" />)}</div>
          <p>You hear from Abdul, Ali or Umer. Never a call centre.</p>
        </div>
      </div>
      <div id="start">
        <Quiz id="q-home" steps={homeSteps} heading="Start here. It takes about 30 seconds." button="Get my plan" success="Got it. One of us will be in touch shortly." />
      </div>
    </div>
  </section>

  <section class="proof" aria-label="About the team">
    <div class="wrap">
      <ul>
        <li><strong>3 licensed agents</strong>A father and his two sons</li>
        <li><strong>Since 2007</strong>Abdul's nearly 20 years in Ontario real estate</li>
        <li><strong>GTA and beyond</strong>{regions.filter((r) => r !== 'Greater Toronto Area').join(', ')}</li>
        <li><strong>CENTURY 21</strong>Green Realty Inc., Brokerage</li>
      </ul>
    </div>
  </section>

  <section class="band" style="padding-bottom:0">
    <div class="wrap">
      <ul class="quick" aria-label="Quick tools">
        <li><a href="/home-evaluation/"><span class="ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M12 12.5v5M10.2 16.3c.4.6 1 .9 1.8.9 1 0 1.8-.5 1.8-1.3 0-1.9-3.5-.9-3.5-2.7 0-.7.7-1.2 1.7-1.2.7 0 1.3.3 1.600.8"/></svg></span><span>Home evaluation<small>What is my home worth?</small></span></a></li>
        <li><a href="/mortgage-calculator/"><span class="ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8.5 7.5h7M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 15.5h.01M12 15.5h.01M15.5 15.5h.01"/></svg></span><span>Mortgage calculator<small>Estimate my payment</small></span></a></li>
        <li><a href="/affordability-calculator/"><span class="ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h14a2 2 0 012 2v9a2 2 0 01-2 2H6a2 2 0 01-2-2V7z"/><path d="M4 7l10-3.5V7"/><path d="M16 13.5h.01"/></svg></span><span>Affordability<small>How much can I spend?</small></span></a></li>
        <li><a href="/land-transfer-tax-calculator/"><span class="ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 17l5-5M10.5 12.5h.01M14.5 16.5h.01"/></svg></span><span>Land transfer tax<small>What will I owe on closing?</small></span></a></li>
        <li><a href="/market-report/"><span class="ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4M4 20h16"/><path d="M8 16l3.5-4 3 2.5L19 8"/></svg></span><span>Market report<small>What are homes selling for?</small></span></a></li>
        <li><a href="/listings/"><span class="ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 004 0"/></svg></span><span>Listing alerts<small>Email me new listings</small></span></a></li>
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="cards">
        <div class="card path pattern">
          <h2>Buying a home</h2>
          <ul>
            <li>New listings that match, sent as they hit the market</li>
            <li>Showings booked around your schedule</li>
            <li>An honest read on every home, and on what to offer</li>
          </ul>
          <a class="btn" href="/buy/">Tell us what you want</a>
        </div>
        <div class="card path alt pattern">
          <h2>Selling a home</h2>
          <ul>
            <li>A price based on what has sold near you</li>
            <li>Advice on which fixes are worth doing first</li>
            <li>Every offer negotiated, through to closing day</li>
          </ul>
          <a class="btn" href="/sell/">Get my home's value</a>
        </div>
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="band band-pale" id="projects">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>Upcoming communities and projects</h2>
            <p class="lede">New condos, townhomes and developments across Ontario. Ask us for floor plans and prices.</p>
          </div>
          <div class="rail-nav">
            <button type="button" id="rail-prev" aria-label="Previous projects"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button type="button" id="rail-next" aria-label="Next projects"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
          </div>
        </div>
        <ul class="rail" id="rail" tabindex="0" aria-label="Upcoming projects">
          {projects.map((p) => <li><ProjectCard project={p} /></li>)}
        </ul>
        <div class="actions"><a class="btn btn-line" href="/pre-construction/">See all projects</a></div>
      </div>
    </section>
  )}

  <section class="band band-dark pattern" id="budget">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>What does your budget look like each month?</h2>
          <p class="lede">Drag the sliders. The numbers update as you move.</p>
        </div>
      </div>
      <div class="explorer">
        <div>
          <div class="slider">
            <label for="x-price">Home price <output id="x-price-out" for="x-price"></output></label>
            <input type="range" id="x-price" min="300000" max="2500000" step="25000" value="900000" />
          </div>
          <div class="slider">
            <label for="x-down">Down payment <output id="x-down-out" for="x-down"></output></label>
            <input type="range" id="x-down" min="5" max="50" step="1" value="20" />
          </div>
          <div class="slider">
            <label for="x-rate">Interest rate <output id="x-rate-out" for="x-rate"></output></label>
            <input type="range" id="x-rate" min="2" max="8" step="0.05" value="4.5" />
          </div>
        </div>
        <div class="readout" aria-live="polite">
          <p class="fine" style="margin:0">Estimated mortgage payment</p>
          <p class="big"><span id="x-pay"></span><span style="font-size:1.1rem;font-weight:600;letter-spacing:0"> a month</span></p>
          <table class="result-table">
            <tr><th>Down payment</th><td id="x-cash"></td></tr>
            <tr><th>Ontario land transfer tax</th><td id="x-ltt"></td></tr>
            <tr><th>Mortgage</th><td id="x-loan"></td></tr>
          </table>
          <p class="fine">Principal and interest over 25 years. Leaves out property tax, insurance and condo fees. Toronto buyers pay a second land transfer tax.</p>
          <a class="btn" id="x-cta" href="/buy/">Show me homes in this range</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-pale" id="learn">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Know what to look for before you move</h2>
          <p class="lede">Straight answers on preparing, selling and buying a home in Ontario.</p>
        </div>
        <div class="filter" role="group" aria-label="Show articles about">
          <button class="chip" data-filter="all" aria-pressed="true">All</button>
          <button class="chip" data-filter="Selling" aria-pressed="false">Selling</button>
          <button class="chip" data-filter="Buying" aria-pressed="false">Buying</button>
        </div>
      </div>
      <div class="posts" id="posts">
        {posts.map((p) => (
          <a class="post-card" href={`/blog/${p.id}/`} data-category={p.data.category}>
            <span class={`tag ${p.data.category.toLowerCase()}`}>{p.data.category}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="more">Read in {p.data.minutes} minutes</span>
          </a>
        ))}
      </div>
      <div class="actions"><a class="btn btn-line" href="/blog/">See all articles</a></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Three licensed agents, one family</h2>
          <p class="lede">When you call, you reach one of us.</p>
        </div>
        <a class="btn btn-line" href="/about/">About the team</a>
      </div>
      <div class="people">
        {team.map((p) => (
          <div class="person">
            {p.photo
              ? <img src={asset(p.photo)!.src} alt={p.name} width="400" height="400" loading="lazy" />
              : <div class="no-photo" aria-hidden="true">{p.name[0]}</div>}
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            {p.bio && <p>{p.bio}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-pale">
    <div class="wrap split">
      <div>
        <h2>New condos and developments, before the public launch</h2>
        <p class="lede">Builders send us floor plans and price lists before they open to the public. Join the list and we forward the ones that match what you want.</p>
        <div class="actions"><a class="btn btn-line" href="/pre-construction/">How pre-construction works</a></div>
      </div>
      <LeadForm type="preconstruction" heading="Join the pre-construction list" button="Add me to the list" success="You're on the list. We'll email you when a matching project comes in." />
    </div>
  </section>

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const money = (n) => n.toLocaleString('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 });
      const short = (n) => (n >= 1e6 ? '$' + (n / 1e6).toFixed(n % 1e5 ? 2 : 1).replace(/\.?0+$/, '') + 'M' : '$' + Math.round(n / 1000) + 'K');
      const brackets = [[55000, 0.005], [250000, 0.01], [400000, 0.015], [2000000, 0.02], [Infinity, 0.025]];
      const ltt = (price) => { let t = 0, lo = 0; for (const [hi, r] of brackets) { if (price > lo) t += (Math.min(price, hi) - lo) * r; lo = hi; } return t; };
      const bucket = (p) => p < 600000 ? 'Under $600K' : p < 800000 ? '$600K to $800K' : p < 1000000 ? '$800K to $1M' : p < 1500000 ? '$1M to $1.5M' : p <= 2000000 ? '$1.5M to $2M' : 'Over $2M';
      const run = () => {
        const price = +$('x-price').value, pct = +$('x-down').value, rate = +$('x-rate').value / 100;
        const down = price * pct / 100, loan = price - down;
        const m = Math.pow(1 + rate / 2, 1 / 6) - 1, n = 300;
        $('x-price-out').textContent = short(price);
        $('x-down-out').textContent = pct + '%';
        $('x-rate-out').textContent = (rate * 100).toFixed(2) + '%';
        $('x-pay').textContent = money(loan * m / (1 - Math.pow(1 + m, -n)));
        $('x-cash').textContent = money(down);
        $('x-ltt').textContent = money(ltt(price));
        $('x-loan').textContent = money(loan);
        $('x-cta').href = '/buy/?budget=' + encodeURIComponent(bucket(price));
      };
      ['x-price', 'x-down', 'x-rate'].forEach((id) => $(id).addEventListener('input', run));
      run();

      const rail = $('rail');
      if (rail) {
        const prev = $('rail-prev'), next = $('rail-next');
        const move = (dir) => rail.scrollBy({ left: dir * rail.clientWidth, behavior: 'smooth' });
        const state = () => {
          prev.disabled = rail.scrollLeft < 8;
          next.disabled = rail.scrollLeft + rail.clientWidth > rail.scrollWidth - 8;
        };
        prev.addEventListener('click', () => move(-1));
        next.addEventListener('click', () => move(1));
        rail.addEventListener('scroll', state, { passive: true });
        state();
      }

      const chips = [...document.querySelectorAll('[data-filter]')];
      chips.forEach((chip) => chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        document.querySelectorAll('#posts .post-card').forEach((card) => {
          card.hidden = chip.dataset.filter !== 'all' && card.dataset.category !== chip.dataset.filter;
        });
      }));
    })();
  </script>
</Base>
