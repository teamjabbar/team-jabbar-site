---
import { asset } from '../assets';
interface Props { project: any }
const { project } = Astro.props;
const d = project.data;
const pic = asset(d.image);
const mono = d.name.split(/\s+/).slice(0, 2).map((w: string) => w[0]).join('').toUpperCase();
---
<a class="project-card" href={`/pre-construction/${project.id}/`} data-city={d.city} data-types={d.homeTypes.join('|')} data-status={d.status}>
  <div class="project-pic">
    {pic ? <img src={pic.src} width={pic.w} height={pic.h} alt="" loading="lazy" /> : <span class="mono" aria-hidden="true">{mono}</span>}
    <span class="status">{d.status}</span>
  </div>
  <div class="project-body">
    <h3>{d.name}</h3>
    <p class="project-where">{d.area ? `${d.area}, ${d.city}` : d.city} · by {d.builder}</p>
    <ul class="project-facts">
      {d.homeTypes.map((t: string) => <li>{t}</li>)}
      {d.priceFrom && <li>From {d.priceFrom}</li>}
      {d.occupancy && <li>{/^\d/.test(d.occupancy) ? `Occupancy ${d.occupancy}` : d.occupancy}</li>}
    </ul>
    <span class="more">See details and get floor plans</span>
  </div>
</a>
