---
import '../styles/global.css';
import { site, nav } from '../site';

interface Props { title: string; description: string; article?: boolean; }
const { title, description, article = false } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = `${title} | ${site.name}`;
const canonical = new URL(path, site.url).href;
const year = new Date().getFullYear();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: site.name,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  areaServed: 'Ontario, Canada',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.brokerage.street,
    addressLocality: 'Mississauga',
    addressRegion: 'ON',
    postalCode: 'L5W 1Z3',
    addressCountry: 'CA',
  },
  parentOrganization: { '@type': 'Organization', name: site.brokerage.name },
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#2d2d2d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${site.name} home`}><img src={site.images.logoWhite} alt="The Jabbars" width="200" height="58" /></a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li><a class="call" href={site.phoneHref}>Call {site.phone}</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <p class="brokerage-name">{site.brokerage.name}</p>
            <p>{site.brokerage.note}</p>
            <p>
              {site.brokerage.street}<br />
              {site.brokerage.city}
            </p>
          </div>
          <div>
            <h2>Reach the team</h2>
            <ul>
              <li>Direct: <a href={site.phoneHref}>{site.phone}</a></li>
              <li>Office: <a href={site.brokerage.officeHref}>{site.brokerage.office}</a></li>
              <li>Fax: {site.brokerage.fax}</li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href={site.social.facebook} rel="noopener">Facebook</a> and <a href={site.social.instagram} rel="noopener">Instagram</a></li>
            </ul>
          </div>
          <div>
            <h2>On this site</h2>
            <ul>
              <li><a href="/home-evaluation/">Free home evaluation</a></li>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy policy</a></li>
              <li><a href="https://www.reco.on.ca/reco-information-guide" rel="noopener">RECO Information Guide</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <p>
            The trademarks REALTOR®, REALTORS® and the REALTOR® logo are controlled by The Canadian Real Estate
            Association (CREA) and identify real estate professionals who are members of CREA. The trademarks MLS®,
            Multiple Listing Service® and the associated logos are owned by CREA and identify the quality of services
            provided by real estate professionals who are members of CREA.
          </p>
          <p>
            Information on this website is believed to be accurate but is not guaranteed and should be independently
            verified. It is not intended to replace professional real estate, financial or legal advice. Not intended
            to solicit buyers or sellers currently under contract with a brokerage.
          </p>
          <p>© {year} {site.name}. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <div class="dock" id="dock">
      <a class="btn btn-line" href={site.phoneHref}>Call</a>
      <a class="btn btn-gold" href="/#start" id="dock-start">Get started</a>
    </div>

    <script is:inline>
      (() => {
        const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];

        // Menu
        const toggle = document.querySelector('.nav-toggle');
        const nav = document.getElementById('site-nav');
        toggle?.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });

        // Phone dock: point at this page's form if it has one, and stay out of its way
        const dock = document.getElementById('dock');
        const start = document.getElementById('start');
        if (start) document.getElementById('dock-start').setAttribute('href', '#start');
        const dockState = () => {
          let show = window.scrollY > 300;
          if (start) {
            const r = start.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) show = false;
          }
          dock.classList.toggle('show', show);
        };
        window.addEventListener('scroll', dockState, { passive: true });
        dockState();

        const send = async (form) => {
          const res = await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), source: location.pathname }),
          });
          if (!res.ok) throw new Error();
        };
        const failed = (form) => "This didn't send. Call or text us at " + form.dataset.phone + ' and we will take it from there.';

        // Single-step forms
        $$('form[data-lead]').forEach((form) => {
          const status = form.querySelector('.form-status');
          const button = form.querySelector('button[type=submit]');
          const label = button.textContent;
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            status.textContent = '';
            status.removeAttribute('data-state');
            button.disabled = true;
            button.textContent = 'Sending';
            try {
              await send(form);
              form.reset();
              status.textContent = form.dataset.success;
            } catch {
              status.dataset.state = 'error';
              status.textContent = failed(form);
            }
            button.disabled = false;
            button.textContent = label;
          });
        });

        // Multi-step forms
        $$('form[data-quiz]').forEach((form) => {
          const steps = $$('[data-step]', form);
          const bar = form.querySelector('.quiz-progress span');
          const count = form.querySelector('.quiz-count');
          const back = form.querySelector('.quiz-back');
          const done = form.querySelector('.quiz-done');
          let current = 0;

          // Answers passed in the link, e.g. /buy/?budget=$800K to $1M
          const params = new URLSearchParams(location.search);
          params.forEach((value, name) => {
            const radio = $$('input[type=radio]', form).find((r) => r.name === name && r.value === value);
            if (radio) radio.checked = true;
            const text = form.querySelector('input.quiz-input[name="' + CSS.escape(name) + '"]');
            if (text) text.value = value;
          });

          const show = (i, focus = true) => {
            current = i;
            steps.forEach((s, n) => (s.hidden = n !== i));
            const step = steps[i];
            const last = i === steps.length - 1;
            bar.style.width = ((i + (last ? 0.85 : 0.15)) / steps.length) * 100 + '%';
            count.textContent = last ? 'Last step' : 'Question ' + (i + 1) + ' of ' + steps.length;
            back.hidden = i === 0;
            if (step.dataset.titleBy) {
              const by = JSON.parse(step.dataset.titleBy);
              const type = new FormData(form).get('type');
              if (by[type]) step.querySelector('legend').textContent = by[type];
            }
            if (focus) (step.querySelector('.quiz-input, input[name=name]') || step.querySelector('legend')).focus({ preventScroll: true });
            if (focus && form.getBoundingClientRect().top < 76) form.scrollIntoView({ block: 'start' });
          };
          const next = () => { form.classList.add('js'); show(Math.min(current + 1, steps.length - 1)); };

          steps.forEach((step) => {
            const kind = step.dataset.kind;
            const error = step.querySelector('.quiz-error');
            if (kind === 'choice') {
              $$('input[type=radio]', step).forEach((r) => {
                r.addEventListener('click', () => setTimeout(next, 160));
              });
            }
            if (kind === 'text') {
              const input = step.querySelector('.quiz-input');
              const go = () => {
                if (!input.value.trim()) { error.hidden = false; input.focus(); return; }
                error.hidden = true;
                next();
              };
              step.querySelector('.quiz-next').addEventListener('click', go);
              input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); go(); } });
              const chips = $$('.chip', step);
              const sync = () => chips.forEach((c) => c.setAttribute('aria-pressed', String(input.value.split(',').map((v) => v.trim()).includes(c.dataset.chip))));
              chips.forEach((chip) => chip.addEventListener('click', () => {
                const picked = input.value.split(',').map((v) => v.trim()).filter(Boolean);
                const at = picked.indexOf(chip.dataset.chip);
                at >= 0 ? picked.splice(at, 1) : picked.push(chip.dataset.chip);
                input.value = picked.join(', ');
                error.hidden = true;
                sync();
              }));
              input.addEventListener('input', sync);
              sync();
            }
            if (kind === 'pair') {
              step.querySelector('.quiz-next').addEventListener('click', () => {
                const groups = $$('.pair-group', step);
                if (groups.some((g) => !g.querySelector('input:checked'))) { error.hidden = false; return; }
                error.hidden = true;
                next();
              });
            }
          });

          back.addEventListener('click', () => show(Math.max(current - 1, 0)));

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (current !== steps.length - 1) { next(); return; }
            const status = form.querySelector('.form-status');
            const button = form.querySelector('.quiz-submit');
            const label = button.textContent;
            status.textContent = '';
            status.removeAttribute('data-state');
            button.disabled = true;
            button.textContent = 'Sending';
            try {
              await send(form);
              steps.forEach((s) => (s.hidden = true));
              back.hidden = true;
              count.hidden = true;
              bar.style.width = '100%';
              done.hidden = false;
              done.focus({ preventScroll: true });
            } catch {
              status.dataset.state = 'error';
              status.textContent = failed(form);
              button.disabled = false;
              button.textContent = label;
            }
          });

          show(0, false);
        });
      })();
    </script>
  </body>
</html>
